# 로컬(호스트)에서 직접 실행할 때 — 호스트에 매핑된 TimescaleDB 포트(5433)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=stockflow
DB_USERNAME=postgres
DB_PASSWORD=postgres

# 실시간 동기화 (market_ticks_1m → ohlcv_1m)
LIVE_SYNC_INTERVAL_SECONDS=60
LIVE_SYNC_SETTLE_MINUTES=2
LIVE_SYNC_LOOKBACK_MINUTES=15
LIVE_SYNC_WIDE_LOOKBACK_MINUTES=190

# 결측 복구 / 일일 확정
REPAIR_LOOKBACK_HOURS=6
REPAIR_SETTLE_MINUTES=10
CONFIRM_HOUR_UTC=1
CONFIRM_MINUTE_UTC=30

# Binance 백필 호출 간격 / 분당 요청 가중치 상한
ARCHIVE_PAUSE_SECONDS=0.3
REST_PAUSE_SECONDS=0.2
BINANCE_WEIGHT_SOFT_LIMIT=3000

LOG_LEVEL=INFO
