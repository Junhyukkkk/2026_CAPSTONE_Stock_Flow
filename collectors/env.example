# Kafka 설정
KAFKA_BOOTSTRAP_SERVERS=kafka:9093
KAFKA_CLIENT_ID_PREFIX=stockflow-collector

# Binance 설정
BINANCE_TOP_SYMBOLS_LIMIT=300
BINANCE_TOPIC_NAME=market.binance.tick

# Alpaca 설정 (필수)
ALPACA_API_KEY=your-api-key-here
ALPACA_API_SECRET=your-api-secret-here
ALPACA_WEBSOCKET_URL=wss://stream.data.alpaca.markets/v2/iex
ALPACA_TOPIC_NAME=market.alpaca.tick
ALPACA_SUBSCRIBE_ALL_STOCKS=true

# DLQ 설정
DLQ_TOPIC_NAME=market.dlq
DLQ_ENABLED=true

# 로깅
LOG_LEVEL=INFO
