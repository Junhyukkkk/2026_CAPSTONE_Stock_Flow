# infra/docker-compose.yml 용 환경변수 예시.
# 이 파일을 infra/.env 로 복사해서 필요한 값만 채우면 된다. (.env 는 git 무시)
# 대부분 기본값으로 동작하므로 비워둬도 무방하다.

# ─────────────────────────────────────────────────────────────
# 경보 알림 (Alertmanager → Discord)
#   Consumer 적체·유실 임박 경보를 Discord 채널로 보낸다.
#   Discord 채널 → 채널 편집 → 연동 → 웹후크 → 새 웹후크 → URL 복사
#   비워두면 경보는 Prometheus 에서 발동만 하고 전송되지 않는다.
# ─────────────────────────────────────────────────────────────
DISCORD_WEBHOOK=

# ─────────────────────────────────────────────────────────────
# 로그 수집 (Loki) — 기본값으로 동작. 보통 건드릴 필요 없음
# ─────────────────────────────────────────────────────────────
# LOKI_URL=http://loki:3100/loki/api/v1/push

# ─────────────────────────────────────────────────────────────
# 에러 트래킹 (Sentry / GlitchTip)
#   docker compose --profile sentry up -d   → http://localhost:8000
#
#   [데모용으로 미리 만들어 둔 것] (glitchtip-pg-data 볼륨에 저장됨)
#     로그인:  demo@stockflow.local  /  StockFlowDemo123!
#     프로젝트: StockFlow / stockflow-realtime
#     아래 SENTRY_DSN 주석을 풀고 `docker compose up -d stockflow-realtime` 하면 바로 동작.
#     확인:  curl -X POST 'http://localhost:8081/api/dev/raise-error?message=hi'
#
#   ※ docker compose down -v 로 볼륨을 지웠다면 위 계정/DSN 은 사라진다.
#     그 경우 http://localhost:8000 에서 계정·프로젝트를 새로 만들고
#     DSN 호스트를 localhost:8000 → glitchtip-web:8080 으로 바꿔 넣으면 된다.
# ─────────────────────────────────────────────────────────────
# SENTRY_DSN=http://59606a83-0148-4780-8a10-04373038baf1@glitchtip-web:8080/1
SENTRY_DSN=
SENTRY_ENVIRONMENT=docker-local
# GLITCHTIP_SECRET_KEY=change-me-to-a-random-string

# ─────────────────────────────────────────────────────────────
# 데이터 수집기
# ─────────────────────────────────────────────────────────────
# Binance (기본 실행, 키 불필요) — 수집 종목 수
BINANCE_TOP_SYMBOLS_LIMIT=50
LOG_LEVEL=INFO

# Alpaca 미국 주식 (docker compose --profile alpaca up -d, 장중에만 데이터)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# 주식 시세 시뮬레이터 (docker compose --profile sim up -d stock-simulator)
# ⚠️ 가짜 체결을 만든다 (source=SIMULATOR, exchange=SIM). 실제 시세가 아니다. 기본 up 에는 포함되지 않는다.
# SIM_TOTAL_TPS=300             전 종목 합계 초당 체결 수
# SIM_MARKET_HOURS=always       always | us (us = 미국 동부시간 월~금 09:30~16:00 에만 전송)
# SIM_PRICE_SOURCE=static       static(CSV 시작가) | alpaca | auto — 위 ALPACA_API_KEY/SECRET 으로 시작가만 실제 시세에서
#                               읽는다. 실패하거나 키가 없으면 CSV 가격으로 폴백(auto 는 키가 없으면 시도하지 않음)
# SIM_SEED=                     지정하면 같은 가격·수량 시퀀스 재현(tradeId 는 기동마다 다름)
# SIM_TICK_INTERVAL_MS=50       스케줄러 간격(1~2000)
# SIM_SYMBOLS_FILE=simulator/universe.csv   종목 목록 CSV (symbol,price,volatility,weight)
# SIM_DRY_RUN=false             true 면 Kafka 대신 stdout 에 JSON 한 줄씩 출력
